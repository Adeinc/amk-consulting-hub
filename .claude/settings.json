{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash /Users/ola23101/amk-consulting-hub/.claude/hooks/pre-commit-check.sh",
            "timeout": 120,
            "statusMessage": "Running typecheck/build/lint before commit…"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ola23101/amk-consulting-hub/.claude/hooks/block-env-writes.sh",
            "timeout": 10,
            "statusMessage": "Checking file isn't a protected .env file…"
          }
        ]
      }
    ]
  }
}
