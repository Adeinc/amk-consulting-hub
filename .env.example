# Copy to .env.local and fill in with real values. Never commit .env.local.

# Supabase — dev project (production uses a separate Supabase project, per README)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe — publishable key only (test mode for dev). Secret key lives only in the
# Supabase Edge Function environment, never here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Resend is called server-side only (Edge Function) — no client env var needed here.
